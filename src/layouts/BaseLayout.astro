---
import "~/styles/global.css";
import { getImage } from "astro:assets";
import SEOHead from "~/components/seo/SEOHead.astro";
import BackgroundScene from "~/components/scene/BackgroundScene.astro";
import CausticLight from "~/components/scene/CausticLight.astro";
import MarineSnow from "~/components/scene/MarineSnow.astro";
import BathymetryFooter from "~/components/footer/BathymetryFooter.astro";
import PingCursor from "~/components/effects/PingCursor.astro";
import DepthGauge from "~/components/scene/DepthGauge.astro";
import headshot from "~/assets/headshot.jpg";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** When true, emits a high-priority preload hint for the hero headshot.
   *  Pass on pages that render the Hero so the LCP element starts fetching
   *  before the browser parses the <img> tag. */
  preloadHero?: boolean;
  /** Ambient scene variant. "directed-energy" drops the subsea fleet so the
   *  HELIOS + Reaper directed-energy engagements lead (used on /directed-energy). */
  sceneVariant?: "full" | "directed-energy";
}

const {
  title,
  description,
  canonical,
  preloadHero = false,
  sceneVariant = "full",
} = Astro.props;

// Resolve the optimized AVIF version of the headshot for preloading.
// 80px @ 2x density matches the displayed 80x80 avatar in the Hero.
const heroPreload = preloadHero
  ? await getImage({ src: headshot, format: "avif", width: 160, height: 160 })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead title={title} description={description} canonical={canonical} />
    {/* Before first paint: restore the visitor's "pause motion" choice, and
        flag low-power devices for the lighter ambient scene. */}
    <script is:inline>
      try {
        if (localStorage.getItem("motion") === "paused") {
          document.documentElement.classList.add("motion-paused");
        }
      } catch (e) {}
      if ((navigator.hardwareConcurrency || 8) <= 4 || (navigator.deviceMemory || 8) <= 4) {
        document.documentElement.classList.add("scene-lite");
      }
    </script>
    {
      heroPreload && (
        <link
          rel="preload"
          as="image"
          href={heroPreload.src}
          type="image/avif"
          fetchpriority="high"
        />
      )
    }
  </head>
  <body class="min-h-dvh scene-deferred">
    <CausticLight />
    <BackgroundScene variant={sceneVariant} />
    <MarineSnow />
    <div class="grain-overlay" aria-hidden="true"></div>
    <DepthGauge />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-teal focus:px-3 focus:py-2 focus:text-navy-black focus:font-medium"
    >
      Skip to content
    </a>
    <main id="main" class="relative z-10">
      <slot />
    </main>
    <BathymetryFooter />
    <PingCursor />

    {/* Defer ambient scene paint until after LCP — keeps initial render
        focused on the hero, then fades the maritime layers in once the
        browser is idle. SSR HTML still includes everything so SEO and
        no-JS users see it; this only affects perceived load. */}
    <script is:inline>
      (function () {
        var reveal = function () {
          document.body.classList.remove("scene-deferred");
        };
        var whenIdle = function () {
          if ("requestIdleCallback" in window) {
            requestIdleCallback(reveal, { timeout: 1500 });
          } else {
            setTimeout(reveal, 600);
          }
        };
        // Scene layers are positioned by % of page height, so they must not
        // become visible until web fonts have swapped in and the page height
        // is final — otherwise the swap reflow moves them (layout shift).
        // Capped at 3s so a slow font never holds the scene back forever.
        var fontsReady = document.fonts && document.fonts.ready
          ? document.fonts.ready
          : Promise.resolve();
        Promise.race([
          fontsReady,
          new Promise(function (r) { setTimeout(r, 3000); }),
        ]).then(whenIdle);
      })();
    </script>
  </body>
</html>
