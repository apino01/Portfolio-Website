---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/hero/Hero.astro";
import About from "~/components/about/About.astro";
import ExperienceSection from "~/components/experience/ExperienceSection.astro";
import ProjectsSection from "~/components/projects/ProjectsSection.astro";
import ContactSection from "~/components/contact/ContactSection.astro";
---

<BaseLayout
  title="Andrés Pino — Undersea Vehicle Power & Energy Systems · Anduril"
  description="Power Electronics and Energy Systems Engineer at Anduril Industries, leading energy for an ultra-long-range maritime autonomous vehicle. 20 years across AUV/UUV, Navy sonar, and directed energy. San Diego · active TS clearance."
  preloadHero
>
  <div
    class="grid min-h-dvh gap-12 px-6 py-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20 lg:px-16 lg:py-0 xl:px-24 2xl:px-32"
  >
    <Hero />

    <section class="flex flex-col gap-24 pb-12 lg:py-24">
      <About />
      <ProjectsSection />
      <ExperienceSection />
      <ContactSection />
    </section>
  </div>
</BaseLayout>
