---
import BaseLayout from "~/layouts/BaseLayout.astro";

const modes = [
  {
    n: "01",
    title: "Architecture & design review",
    body:
      "Independent senior eyes on your system architecture, power conversion and distribution, and integration risk — before the design review finds it for you. Written findings with severity and recommended fixes.",
    fit: "Best before PDR/CDR, or when a design feels stuck.",
  },
  {
    n: "02",
    title: "Trade-space analysis",
    body:
      "Quantified trades on HEL power architectures, pressure-tolerant and battery power, sonar front-ends, and maritime autonomy — from someone who has carried these decisions to delivery, not just modeled them.",
    fit: "Best when two viable paths need a defensible decision.",
  },
  {
    n: "03",
    title: "Program & technical due diligence",
    body:
      "Independent assessment of a directed-energy or undersea program claim — schedule realism, technical maturity, and the risks a pitch deck won't surface. For investors, primes, and program offices.",
    fit: "Best before you commit capital or award.",
  },
  {
    n: "04",
    title: "Fractional chief engineer",
    body:
      "Ongoing senior technical leadership for startups and small teams shipping defense or maritime hardware without a 20-year bench — design authority, review cadence, and supplier/customer technical interface.",
    fit: "Best from seed through first delivery.",
  },
];

const steps = [
  {
    n: "1",
    title: "Describe the problem",
    body: "Use the contact form — two or three sentences is enough. No prep needed.",
  },
  {
    n: "2",
    title: "Response within 48 hours",
    body: "A short scoping call to confirm fit. If I'm not the right person, I'll say so and point you to someone better.",
  },
  {
    n: "3",
    title: "Scoped engagement",
    body: "Clear deliverable, timeline, and terms before work starts. NDA-friendly.",
  },
];
---

<BaseLayout
  title="Advisory Services — Defense & Maritime Hardware"
  description="Engineering advisory for defense and maritime programs — architecture review, trade-space analysis, technical due diligence, and fractional chief engineer. 20 years across HEL, sonar, and undersea autonomy."
>
  <div class="px-6 py-16 lg:px-16 lg:py-24 xl:px-24 2xl:px-32">
    <a
      href="/"
      class="group inline-flex items-center gap-2 font-mono text-sm text-teal hover:underline"
    >
      <span aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">←</span>
      Back to home
    </a>

    <header class="mt-8 max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-[0.20em] text-teal">
        Advisory · Services
      </p>
      <h1 class="mt-3 text-3xl font-semibold text-near-white sm:text-4xl">
        Senior technical judgment, when the hardware has to work.
      </h1>
      <p class="mt-5 text-lg text-light-slate">
        Twenty years taking directed-energy, sonar, and undersea-autonomy
        hardware from concept to delivery — as chief engineer, senior manager,
        and lead electrical engineer. I take a small number of advisory
        engagements alongside my full-time role.
      </p>
    </header>

    <div class="my-10 h-px w-full bg-slate/20" aria-hidden="true"></div>

    <section aria-labelledby="modes-heading">
      <h2 id="modes-heading" class="text-xl font-semibold text-near-white">
        Ways to engage
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          modes.map((m) => (
            <article class="rounded-md border border-slate/20 bg-deep-navy/40 p-6 transition-colors hover:border-teal/40">
              <p class="font-mono text-xs tracking-[0.20em] text-teal">{m.n}</p>
              <h3 class="mt-2 text-lg font-semibold text-near-white">{m.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-light-slate">{m.body}</p>
              <p class="mt-4 font-mono text-xs text-slate">{m.fit}</p>
            </article>
          ))
        }
      </div>
    </section>

    <div class="my-10 h-px w-full bg-slate/20" aria-hidden="true"></div>

    <section class="grid gap-12 lg:grid-cols-[2fr_1fr]" aria-labelledby="process-heading">
      <div>
        <h2 id="process-heading" class="text-xl font-semibold text-near-white">
          How it works
        </h2>
        <ol class="mt-6 space-y-6">
          {
            steps.map((s) => (
              <li class="flex gap-5">
                <span
                  aria-hidden="true"
                  class="flex h-8 w-8 flex-none items-center justify-center rounded-full border border-teal/50 font-mono text-sm text-teal"
                >
                  {s.n}
                </span>
                <div>
                  <h3 class="font-semibold text-near-white">{s.title}</h3>
                  <p class="mt-1 text-sm text-light-slate">{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="mt-8 max-w-2xl text-sm text-slate">
          Domain background: <a href="/directed-energy/" class="text-teal hover:underline">directed energy</a>, <a href="/sonar/" class="text-teal hover:underline">sonar & acoustics</a>, <a href="/auv-uuv/" class="text-teal hover:underline">AUV/UUV</a> — or the <a href="/projects/" class="text-teal hover:underline">full program record</a>.
        </p>
      </div>

      <aside class="space-y-8">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-[0.20em] text-teal">
            Background
          </h2>
          <ul class="mt-3 space-y-2 text-sm text-light-slate">
            <li class="flex items-start gap-2">
              <span aria-hidden="true" class="mt-2 inline-block h-px w-3 flex-none bg-teal/60" />
              <span>20 years, concept → fleet delivery</span>
            </li>
            <li class="flex items-start gap-2">
              <span aria-hidden="true" class="mt-2 inline-block h-px w-3 flex-none bg-teal/60" />
              <span>Programs for General Atomics, L3Harris, Lockheed Martin, Terradepth, U.S. Navy</span>
            </li>
            <li class="flex items-start gap-2">
              <span aria-hidden="true" class="mt-2 inline-block h-px w-3 flex-none bg-teal/60" />
              <span>Active TS clearance</span>
            </li>
            <li class="flex items-start gap-2">
              <span aria-hidden="true" class="mt-2 inline-block h-px w-3 flex-none bg-teal/60" />
              <span>M.S. EE, Johns Hopkins · San Diego, CA</span>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="font-mono text-xs uppercase tracking-[0.20em] text-teal">
            Leave-behind
          </h2>
          <p class="mt-3 text-sm text-light-slate">
            One-page capability statement — competencies, past performance, and
            engagement modes in the format your contracts team expects.
          </p>
          <a
            href="/andres-pino-capability-statement.pdf"
            class="mt-3 inline-flex min-h-[44px] items-center gap-2 font-mono text-sm text-teal hover:underline"
          >
            Capability statement (PDF)
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="rounded-md border border-teal/30 bg-deep-navy/40 p-5">
          <p class="font-mono text-[10px] uppercase tracking-[0.20em] text-teal">
            Engage
          </p>
          <p class="mt-2 text-sm text-light-slate">
            Describe the problem — response within 48 hours.
          </p>
          <a
            href="/#contact"
            class="mt-4 inline-flex items-center gap-2 font-mono text-sm text-teal hover:underline"
          >
            Start a conversation
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </section>
  </div>
</BaseLayout>
