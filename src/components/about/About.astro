---
import SectionHeading from "~/components/ui/SectionHeading.astro";
import Tag from "~/components/ui/Tag.astro";

// Top row.
const technicalDomains = [
  "Undersea Systems & Autonomy",
  "System Architecture",
  "Sonar & Acoustics",
  "Hardware Lifecycle",
];
// Second row: the rest.
const technicalDisciplines = [
  "Power Electronics",
  "Directed Energy / HEL",
  "Systems Engineering",
];
const leadership = [
  "Technical Leadership",
  "R&D Leadership",
  "Team Management",
  "Program Execution",
];
---

<section id="about" aria-labelledby="about-heading" class="scroll-mt-24">
  <SectionHeading title="About" depth="Surface" />

  <div class="max-w-prose space-y-8 text-slate">
    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-teal">
        Today
      </h3>
      <p class="mt-2 leading-[1.75]">
        I'm a Power Electronics and Energy Systems Engineer on Anduril
        Industries' Maritime Enabling Technologies team, working from Anduril's
        Costa Mesa headquarters. I lead the energy subsystem for an
        ultra-long-range maritime autonomous vehicle — battery systems, power
        distribution, energy management, and external charging, from concept
        through production. It's the same problem I've chased my whole career:
        keeping undersea vehicles powered and on mission longer.
      </p>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-teal">
        Background
      </h3>
      <p class="mt-2 leading-[1.75]">
        Before Anduril, I led electrical development for autonomous underwater
        vehicles at Terradepth — including a heavy-fuel generator for
        in-mission recharging that produced one of the longest-endurance AUVs
        in its class — and at Lockheed Martin on the Marlin AUV and the RAP-VLA
        undersea surveillance system. As Chief Engineer at L3Harris I led
        manufacturing and delivery of Navy sonar — lightweight torpedo arrays,
        Virginia-class conformal arrays, dipping sonar, and towed arrays. Most
        recently I led the power electronics group for high-energy laser
        programs at General Atomics Electromagnetic Systems.
      </p>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-teal">
        What I do now
      </h3>
      <p class="mt-2 leading-[1.75]">
        I advise startups, small businesses, and engineering teams that need
        senior technical judgment on hard hardware problems — system
        architecture, power conversion and distribution, design reviews,
        integration risk, maritime autonomy, subsea sensing, and
        battery-powered systems designed for precision, reliability, and
        harsh environments.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-slate/85">
        M.S. Electrical Engineering, Johns Hopkins (power electronics, analog
        circuit design, acoustics) · Active Top Secret clearance.
      </p>
    </div>
  </div>

  {/* Competencies — split into Technical / Leadership groups for visual breath */}
  <div class="mt-10 space-y-4">
    <div>
      <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.20em] text-teal/85">
        Technical domains
      </p>
      <ul class="flex flex-wrap gap-2" aria-label="Technical domains">
        {technicalDomains.map((c) => <li><Tag label={c} /></li>)}
        {/* Forced wrap so the three disciplines sit together on the bottom row */}
        <li class="basis-full" aria-hidden="true"></li>
        {technicalDisciplines.map((c) => <li><Tag label={c} /></li>)}
      </ul>
    </div>
    <div>
      <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.20em] text-teal/85">
        Leadership &amp; program execution
      </p>
      <ul class="flex flex-wrap gap-2" aria-label="Leadership signals">
        {leadership.map((c) => <li><Tag label={c} /></li>)}
      </ul>
    </div>

    <div>
      <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.20em] text-teal/85">
        Explore by domain
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm" aria-label="Domain pages">
        <li>
          <a href="/auv-uuv/" class="group inline-flex min-h-[44px] items-center gap-1.5 text-light-slate transition-colors hover:text-teal">
            AUV / UUV
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </li>
        <li>
          <a href="/sonar/" class="group inline-flex min-h-[44px] items-center gap-1.5 text-light-slate transition-colors hover:text-teal">
            Sonar &amp; Acoustics
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </li>
        <li>
          <a href="/directed-energy/" class="group inline-flex min-h-[44px] items-center gap-1.5 text-light-slate transition-colors hover:text-teal">
            Directed Energy
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  {/* How I work — modern AI-augmented tooling on a 20-year foundation */}
  <div class="mt-10 max-w-prose space-y-3">
    <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-teal">
      How I work
    </h3>
    <p class="text-sm leading-relaxed text-slate">
      I pair 20 years of systems-engineering judgment with modern
      AI-augmented tooling — faster turn on artifacts, fewer dropped details,
      tighter review loops on critical paths. Force multipliers, not
      substitutes for engineering judgment.
    </p>
    <div>
      <p class="mb-2 mt-4 font-mono text-[10px] uppercase tracking-[0.20em] text-teal/85">
        Daily tooling
      </p>
      <ul class="flex flex-wrap gap-2" aria-label="Daily tooling">
        <li><Tag label="Claude Code" /></li>
        <li><Tag label="Cowork" /></li>
        <li><Tag label="Claude" /></li>
        <li><Tag label="ChatGPT Codex" /></li>
      </ul>
    </div>
  </div>
</section>
