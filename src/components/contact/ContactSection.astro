---
import SectionHeading from "~/components/ui/SectionHeading.astro";
import IconLink from "~/components/ui/IconLink.astro";
import LinkedInIcon from "~/components/ui/icons/LinkedInIcon.astro";

const formspreeEndpoint = "https://formspree.io/f/xjgjzrjz";
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="scroll-mt-24"
>
  <SectionHeading title="Contact" depth="5000 — 6000 m" />

  <div class="contact-card grid gap-10 rounded-lg border border-teal/15 bg-deep-navy/60 p-6 shadow-[0_4px_24px_rgba(0,0,0,0.35)] backdrop-blur-sm sm:p-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <div>
      <p class="max-w-prose text-white">
        Open to advisory and consulting engagements — system architecture,
        systems engineering, power electronics, undersea systems and
        autonomy, and technical and team management. Send a short note
        about your problem and a timeline.
      </p>

      <form
        action={formspreeEndpoint}
        method="POST"
        class="mt-8 grid gap-5"
        data-contact-form
      >
        <div class="grid gap-2">
          <label
            for="contact-name"
            class="font-mono text-xs uppercase tracking-widest text-white"
          >
            Name
          </label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="rounded-md border border-slate/40 bg-deep-navy/70 px-4 py-3 text-white placeholder:text-white/80 focus:border-teal focus:outline-none focus:ring-1 focus:ring-teal"
          />
        </div>

        <div class="grid gap-2">
          <label
            for="contact-email"
            class="font-mono text-xs uppercase tracking-widest text-white"
          >
            Email
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="rounded-md border border-slate/40 bg-deep-navy/70 px-4 py-3 text-white placeholder:text-white/80 focus:border-teal focus:outline-none focus:ring-1 focus:ring-teal"
          />
        </div>

        <div class="grid gap-2">
          <label
            for="contact-organization"
            class="font-mono text-xs uppercase tracking-widest text-white"
          >
            Organization <span class="text-white/80">(optional)</span>
          </label>
          <input
            id="contact-organization"
            name="organization"
            type="text"
            autocomplete="organization"
            class="rounded-md border border-slate/40 bg-deep-navy/70 px-4 py-3 text-white placeholder:text-white/80 focus:border-teal focus:outline-none focus:ring-1 focus:ring-teal"
          />
        </div>

        <div class="grid gap-2">
          <label
            for="contact-message"
            class="font-mono text-xs uppercase tracking-widest text-white"
          >
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            class="resize-y rounded-md border border-slate/40 bg-deep-navy/70 px-4 py-3 text-white placeholder:text-white/80 focus:border-teal focus:outline-none focus:ring-1 focus:ring-teal"
          ></textarea>
        </div>

        {/* Honeypot — hidden field bots fill in. */}
        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />

        <div class="flex items-center gap-4">
          <button
            type="submit"
            data-submit-btn
            class="contact-submit relative inline-flex items-center gap-2 overflow-hidden rounded-md border border-teal/40 bg-teal/10 px-5 py-3 font-mono text-sm text-teal transition-colors hover:bg-teal/20 focus:outline-none focus:ring-2 focus:ring-teal disabled:opacity-60"
          >
            {/* Sonar pulse — emanates from button center while transmitting */}
            <span class="contact-submit__pulse" aria-hidden="true"></span>
            <span data-submit-label class="relative">Send message</span>
            <span aria-hidden="true" class="relative">→</span>
          </button>
          <p
            data-form-status
            role="status"
            aria-live="polite"
            class="font-mono text-xs text-white"
          ></p>
        </div>
      </form>
    </div>

    <aside class="grid content-start gap-6">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-white">
          Response time
        </p>
        <p class="mt-2 text-white">
          Two business days, typically same-day for short notes.
        </p>
      </div>

      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-white">
          Elsewhere
        </p>
        <div class="mt-2 flex gap-2">
          <IconLink
            href="https://www.linkedin.com/in/andresmpino/"
            label="LinkedIn"
          >
            <LinkedInIcon />
          </IconLink>
        </div>
      </div>

      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-white">
          Location
        </p>
        <p class="mt-2 text-white">San Diego, CA</p>
      </div>
    </aside>
  </div>
</section>

<style>
  /* Sonar pulse on the submit button while transmitting — a single ring
     expands from the button center, looping during the send. */
  .contact-submit__pulse {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    border: 1px solid var(--color-teal, #38e8c6);
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0;
    pointer-events: none;
  }
  .contact-submit[data-state="sending"] .contact-submit__pulse {
    animation: contact-pulse 1.1s ease-out infinite;
  }
  @keyframes contact-pulse {
    0%   { transform: translate(-50%, -50%) scale(0.5); opacity: 0.6; }
    100% { transform: translate(-50%, -50%) scale(14); opacity: 0; }
  }
  /* Success: brief settle glow */
  .contact-submit[data-state="sent"] {
    border-color: color-mix(in srgb, var(--color-teal, #38e8c6) 70%, transparent);
    box-shadow: 0 0 16px rgb(56 232 198 / 0.3);
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-submit[data-state="sending"] .contact-submit__pulse {
      animation: none;
      opacity: 0;
    }
    .contact-submit[data-state="sent"] { box-shadow: none; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = document.querySelector<HTMLElement>("[data-form-status]");

  if (form && status) {
    const button = form.querySelector<HTMLButtonElement>("[data-submit-btn]");
    const label = form.querySelector<HTMLElement>("[data-submit-label]");
    const defaultLabel = label?.textContent ?? "Send message";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (button) {
        button.disabled = true;
        button.dataset.state = "sending";
      }
      if (label) label.textContent = "Pinging…";
      status.textContent = "Transmitting…";
      status.classList.remove("text-teal", "text-red-400");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        if (response.ok) {
          form.reset();
          if (label) label.textContent = "Contact established";
          if (button) button.dataset.state = "sent";
          status.textContent = "Contact established. I'll reply within two business days.";
          status.classList.add("text-teal");
        } else {
          const payload = await response.json().catch(() => null);
          const detail = payload?.errors?.[0]?.message ?? "Signal lost — use LinkedIn or try again.";
          if (label) label.textContent = defaultLabel;
          if (button) button.dataset.state = "";
          status.textContent = detail;
          status.classList.add("text-red-400");
        }
      } catch {
        if (label) label.textContent = defaultLabel;
        if (button) button.dataset.state = "";
        status.textContent = "Signal lost — use LinkedIn or try again.";
        status.classList.add("text-red-400");
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
