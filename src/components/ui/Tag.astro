---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<span
  class="inline-flex items-center rounded-full border border-teal/25 bg-teal/[0.06] px-3 py-1 font-mono text-xs text-teal/90 transition-colors duration-200 hover:border-teal/55 hover:bg-teal/[0.12] hover:text-teal"
>
  {label}
</span>
