---
interface Props {
  title: string;
  /** Optional 2-digit ordinal prefix shown as small mono eyebrow above title. */
  number?: string;
  /** Optional decimal depth tag like "180 m" — appears at the right end of the contour line. */
  depth?: string;
}
const { title, number, depth } = Astro.props;
---

<header
  class="section-heading mb-10"
  data-section-heading
>
  {
    number && (
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-teal/85">
        Section {number}
      </p>
    )
  }
  <div class="mt-2 flex items-center gap-4">
    <h2 class="text-2xl font-semibold tracking-tight text-near-white sm:text-3xl">
      {title}
    </h2>

    {/* Bathymetric contour — replaces the simple gradient rule */}
    <div class="ml-1 hidden h-4 flex-1 sm:flex sm:items-center" aria-hidden="true">
      <svg
        viewBox="0 0 600 16"
        preserveAspectRatio="none"
        class="h-full w-full overflow-visible"
      >
        <path
          d="M0 6 Q 50 2 100 6 T 200 6 T 300 6 T 400 6 T 500 6 T 600 6"
          fill="none"
          stroke="rgb(56 232 198 / 0.45)"
          stroke-width="0.6"
        />
        <path
          d="M0 9 Q 60 5 120 9 T 240 9 T 360 9 T 480 9 T 600 9"
          fill="none"
          stroke="rgb(56 232 198 / 0.22)"
          stroke-width="0.5"
        />
        <path
          d="M0 12 Q 70 8 140 12 T 280 12 T 420 12 T 600 12"
          fill="none"
          stroke="rgb(56 232 198 / 0.10)"
          stroke-width="0.5"
        />
      </svg>
      {
        depth && (
          <span class="ml-3 flex-shrink-0 font-mono text-[9px] uppercase tracking-[0.20em] text-teal/55">
            {depth}
          </span>
        )
      }
    </div>
  </div>
</header>

<style>
  .section-heading {
    opacity: 0;
    transition: opacity 600ms ease-out;
  }
  .section-heading.is-visible {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .section-heading {
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  const headings = document.querySelectorAll<HTMLElement>("[data-section-heading]");
  if ("IntersectionObserver" in window && headings.length > 0) {
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
    );
    headings.forEach((h) => obs.observe(h));
  } else {
    headings.forEach((h) => h.classList.add("is-visible"));
  }
</script>
