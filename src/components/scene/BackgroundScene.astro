---
import WaterSurface from "./WaterSurface.astro";

interface Props {
  /** "full" (default) shows the whole subsea fleet. "directed-energy" hides
   *  the sub/torpedo/AUV/seabed clutter and the dipping-sonar helo so the
   *  directed-energy engagements (surface HELIOS + airborne Reaper strafe)
   *  lead the scene on the /directed-energy page. */
  variant?: "full" | "directed-energy";
}
const { variant = "full" } = Astro.props;

// Subsea depth scene v5 — US Navy fleet, populated.
//
// Depth bands:
//   surface          → destroyer + MH-60R helicopter (HELRAS dipping cycle)
//   upper photic     → Ohio-class SSGN + lightweight torpedo (Mk54)
//   mid-water        → Virginia-class SSN + heavyweight torpedo (Mk48) + LA-class SSN
//   deeper mid       → Marlin AUV (Lockheed)
//   mesopelagic      → XLUUV (Boeing Orca) + MDUUV (Snakehead-class) + Manta Ray glider
//   abyssal seabed   → pipeline + wellhead + sensor pod + docked AUV
//                      + bottom-scanning UUV pinging the silt
//
// Helicopter sequence (90s loop) — fast deploy, quick exit:
//   0–5%    fly in from right
//   5–14%   lower sonar package on cable (fast)
//   16–40%  active pinging — downward acoustic wavefronts + returns
//   40–48%  raise sonar back to helicopter
//   48–60%  fly off to the left
//   60–100% off-station (rest)
---

<div
  class:list={[
    "background-scene pointer-events-none absolute inset-0 overflow-hidden",
    variant === "directed-energy" && "scene-de",
  ]}
  aria-hidden="true"
>
  {/* Subtle depth gradient */}
  <div class="bg-depth-gradient absolute inset-0"></div>

  {/* Caustic light rays — top ~22%, very faint */}
  <svg
    class="bg-caustics absolute inset-x-0 top-0 h-[24vh] w-full opacity-[0.05]"
    viewBox="0 0 1200 400"
    preserveAspectRatio="none"
  >
    <defs>
      <linearGradient id="caustic-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#7fdbff" stop-opacity="0.85" />
        <stop offset="100%" stop-color="#7fdbff" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g stroke="url(#caustic-fade)" stroke-width="1.4" fill="none">
      <path d="M 80 0 Q 120 80 60 200 T 100 400" />
      <path d="M 240 0 Q 200 100 280 220 T 240 400" />
      <path d="M 420 0 Q 460 90 380 210 T 440 400" />
      <path d="M 600 0 Q 560 110 640 230 T 600 400" />
      <path d="M 780 0 Q 820 80 740 200 T 800 400" />
      <path d="M 960 0 Q 920 100 1000 220 T 960 400" />
      <path d="M 1120 0 Q 1080 90 1160 210 T 1120 400" />
    </g>
  </svg>

  {/* ════════ SURFACE BAND ════════ */}

  {/* Surface deck — ONE shared coordinate frame for every surface element
     (waterline + destroyer + dipping helicopter). Positioning the three
     together in fixed deck-local pixels (instead of three independent
     document-height percentages) guarantees the hull, the waterline, and the
     dipped transducer stay vertically aligned at any viewport size — the
     bug was that the cable length was absolute px while the surface sat at a
     percentage, so on tall mobile pages the dip stopped short of the water. */}
  <div class="surface-deck">
    {/* Water surface — wavy line marking the air/water transition. The
       destroyer hull rides it; the helicopter cable pierces it. */}
    <WaterSurface />

    {/* Destroyer — rides the surface line (deck-local top). overflow:visible so
        the HELIOS directed-energy beam can fire UP past the SVG viewBox into
        the sky while staying synced to the ship's drift transform. */}
    <svg
      class="bg-vessel bg-vessel-ship absolute"
      style="top: 92px; left: -12%; width: 520px; height: 90px; overflow: visible;"
      viewBox="0 0 600 100"
      preserveAspectRatio="xMidYMid meet"
    >
    <g fill="var(--color-teal, #38e8c6)" opacity="0.20">
      <path d="M 18 56 Q 32 76 80 82 L 480 82 Q 540 82 580 62 L 580 56 Z" />
      <rect x="190" y="36" width="100" height="22" rx="2" />
      <rect x="320" y="38" width="70" height="18" rx="2" />
      <rect x="232" y="10" width="3" height="28" />
      <ellipse cx="234" cy="16" rx="14" ry="3" />
      <rect x="350" y="20" width="2" height="20" />
      <rect x="140" y="48" width="20" height="10" rx="2" />
    </g>
    <g fill="var(--color-teal, #38e8c6)" opacity="0.10">
      <ellipse cx="588" cy="68" rx="10" ry="3" />
      <ellipse cx="600" cy="62" rx="6" ry="2" />
      <ellipse cx="608" cy="68" rx="5" ry="1.5" />
    </g>

    {/* ── HELIOS-style directed-energy engagement ──
        Mounted on the forward deckhouse. Four inbound threats arrive from
        DIFFERENT bearings — two FORWARD (toward the bow) and two AFT (over the
        stern) — so the turret slews fore and aft engaging targets all around as
        the ship transits. Each engagement runs the same 9s keyframes
        phase-shifted by a quarter (--de-delay), so a shot lands ~every 2.25s,
        alternating front and back. Beam uses the directed-energy domain accent
        (#7fe3ff) so the colour ties to the /directed-energy page. */}
    <g class="bg-de">
      {/* Emitter turret on the forward deckhouse (shared aperture) */}
      <rect x="356" y="28" width="18" height="11" rx="2" fill="var(--color-teal, #38e8c6)" opacity="0.55" />
      <circle class="bg-de-aperture" cx="373" cy="31" r="3" fill="#7fe3ff" />

      {/* Engagement 1 — FORWARD high inbound (cruise-missile surrogate) */}
      <g class="bg-de-eng bg-de-eng--1">
        <g class="bg-de-target">
          <path d="M 556 -152 L 572 -150 L 556 -148 Z" fill="#cfefff" opacity="0.9" />
          <rect x="546" y="-151" width="11" height="2.8" rx="1" fill="#cfefff" opacity="0.75" />
        </g>
        <line class="bg-de-beam bg-de-beam--bloom" x1="372" y1="30" x2="556" y2="-150"
              stroke="#7fe3ff" stroke-width="5" stroke-linecap="round" />
        <line class="bg-de-beam bg-de-beam--core" x1="372" y1="30" x2="556" y2="-150"
              stroke="#eafdff" stroke-width="1.7" stroke-linecap="round" />
        <circle class="bg-de-flash" cx="556" cy="-150" r="3" fill="#eafdff" />
      </g>

      {/* Engagement 2 — AFT high diver (over the stern) */}
      <g class="bg-de-eng bg-de-eng--2">
        <g class="bg-de-target">
          <path d="M 190 -152 L 174 -150 L 190 -148 Z" fill="#cfefff" opacity="0.9" />
          <rect x="191" y="-151" width="11" height="2.8" rx="1" fill="#cfefff" opacity="0.75" />
        </g>
        <line class="bg-de-beam bg-de-beam--bloom" x1="372" y1="30" x2="190" y2="-150"
              stroke="#7fe3ff" stroke-width="5" stroke-linecap="round" />
        <line class="bg-de-beam bg-de-beam--core" x1="372" y1="30" x2="190" y2="-150"
              stroke="#eafdff" stroke-width="1.7" stroke-linecap="round" />
        <circle class="bg-de-flash" cx="190" cy="-150" r="3" fill="#eafdff" />
      </g>

      {/* Engagement 3 — FORWARD shallow sea-skimmer */}
      <g class="bg-de-eng bg-de-eng--3">
        <g class="bg-de-target">
          <path d="M 610 -80 L 626 -78 L 610 -76 Z" fill="#cfefff" opacity="0.9" />
          <rect x="600" y="-79" width="11" height="2.8" rx="1" fill="#cfefff" opacity="0.75" />
        </g>
        <line class="bg-de-beam bg-de-beam--bloom" x1="372" y1="30" x2="610" y2="-78"
              stroke="#7fe3ff" stroke-width="5" stroke-linecap="round" />
        <line class="bg-de-beam bg-de-beam--core" x1="372" y1="30" x2="610" y2="-78"
              stroke="#eafdff" stroke-width="1.7" stroke-linecap="round" />
        <circle class="bg-de-flash" cx="610" cy="-78" r="3" fill="#eafdff" />
      </g>

      {/* Engagement 4 — AFT shallow skimmer (low over the stern) */}
      <g class="bg-de-eng bg-de-eng--4">
        <g class="bg-de-target">
          <path d="M 135 -94 L 119 -92 L 135 -90 Z" fill="#cfefff" opacity="0.9" />
          <rect x="136" y="-93" width="11" height="2.8" rx="1" fill="#cfefff" opacity="0.75" />
        </g>
        <line class="bg-de-beam bg-de-beam--bloom" x1="372" y1="30" x2="135" y2="-92"
              stroke="#7fe3ff" stroke-width="5" stroke-linecap="round" />
        <line class="bg-de-beam bg-de-beam--core" x1="372" y1="30" x2="135" y2="-92"
              stroke="#eafdff" stroke-width="1.7" stroke-linecap="round" />
        <circle class="bg-de-flash" cx="135" cy="-92" r="3" fill="#eafdff" />
      </g>
    </g>
  </svg>

  {/* Helicopter with full HELRAS deployment choreography — hovers HIGH in the
     sky band, well off to the side of the ship, and dips a long cable that
     clearly pierces the surface line below it. */}
  <svg
    class="bg-vessel bg-vessel-helo absolute"
    style="top: -28px; right: 6%; width: 200px; height: 480px;"
    viewBox="0 0 240 580"
    preserveAspectRatio="xMidYMid meet"
  >
    {/* Cable — drawn first (behind sonar body), animates scaleY 0 → 1 */}
    <rect
      class="bg-helo-cable"
      x="109"
      y="116"
      width="2"
      height="300"
      fill="var(--color-teal, #38e8c6)"
      opacity="0.30"
    />

    {/* Sonar rig group — translates Y to descend along the cable */}
    <g class="bg-helo-sonar-rig">
      {/* Sonar body cylinder */}
      <rect x="98" y="116" width="24" height="32" rx="3" fill="var(--color-teal, #38e8c6)" opacity="0.34" />
      <ellipse cx="110" cy="148" rx="14" ry="2.5" fill="var(--color-teal, #38e8c6)" opacity="0.50" />

      {/* 3 hydrophone plates that drop from inside the cylinder */}
      <rect class="bg-helo-plate" x="100" y="146" width="5" height="3" rx="1" fill="var(--color-teal, #38e8c6)" />
      <rect class="bg-helo-plate" x="107" y="146" width="6" height="3" rx="1" fill="var(--color-teal, #38e8c6)" />
      <rect class="bg-helo-plate" x="115" y="146" width="5" height="3" rx="1" fill="var(--color-teal, #38e8c6)" />

      {/* NB: the active acoustic wavefronts are rendered in a separate
          .helras-wave-layer below (a sibling of .background-scene) so they can
          sit ABOVE the page content and stay visible over the About section
          instead of being trapped behind it in the scene's stacking context. */}
    </g>

    {/* Helicopter airframe — MH-60R Romeo silhouette */}
    <g class="bg-helo-airframe">
      <g fill="var(--color-teal, #38e8c6)" opacity="0.26">
        {/* 4-blade main rotor disc — wider than legacy 2-blade */}
        <ellipse cx="110" cy="38" rx="106" ry="3" opacity="0.45" />
        {/* Faint diagonal blade hints (4-blade rotor signature) */}
        <line x1="8" y1="38" x2="212" y2="38" stroke="#38e8c6" stroke-width="1" opacity="0.35" />
        <line x1="38" y1="22" x2="182" y2="54" stroke="#38e8c6" stroke-width="0.6" opacity="0.20" />
        <line x1="38" y1="54" x2="182" y2="22" stroke="#38e8c6" stroke-width="0.6" opacity="0.20" />

        {/* Rotor hub + mast */}
        <rect x="104" y="36" width="12" height="4" rx="1" />
        <rect x="108" y="40" width="4" height="12" />

        {/* Twin GE T700 engine intakes — characteristic bulges behind mast */}
        <path d="M 92 50 Q 92 46 96 46 L 110 46 Q 114 46 114 50 L 114 56 L 92 56 Z" />
        <path d="M 106 50 Q 106 46 110 46 L 124 46 Q 128 46 128 50 L 128 56 L 106 56 Z" />

        {/* Main fuselage / cabin — squared Sikorsky H-60 profile */}
        <path d="M 56 58 Q 50 64 50 80 L 50 98 Q 50 110 62 112 L 154 112 Q 168 110 172 100 L 172 78 Q 172 60 158 56 L 70 56 Q 60 56 56 58 Z" />

        {/* Chin-mounted APS-153 multi-mode radar dome — under the nose */}
        <ellipse cx="58" cy="110" rx="12" ry="6" />

        {/* FLIR turret — small ball ahead of the radome */}
        <circle cx="48" cy="100" r="3.5" opacity="0.85" />

        {/* Sonobuoy launcher tubes — port side fuselage (RSL grid) */}
        <rect x="84" y="100" width="18" height="8" rx="1" opacity="0.65" />

        {/* Tail boom — narrower than fuselage */}
        <rect x="172" y="80" width="56" height="9" rx="3" />

        {/* Stabilator — horizontal stab at tail base */}
        <rect x="200" y="84" width="32" height="2.5" rx="1" />

        {/* Vertical tail pylon — supports the canted tail rotor */}
        <path d="M 220 80 Q 226 64 232 60 L 240 68 L 234 88 Z" />

        {/* Wheel sponsons — Romeo has retractable gear in side sponsons */}
        <ellipse cx="80" cy="116" rx="11" ry="4" opacity="0.75" />
        <ellipse cx="148" cy="116" rx="11" ry="4" opacity="0.75" />
        {/* Tail wheel under tail boom */}
        <ellipse cx="216" cy="93" rx="3.5" ry="2.5" opacity="0.7" />
      </g>

      {/* Canted tail rotor (~18° Sikorsky H-60 signature cant) */}
      <g transform="rotate(-18 234 74)">
        <ellipse cx="234" cy="74" rx="2.5" ry="12" fill="var(--color-teal, #38e8c6)" opacity="0.50" />
        <line x1="234" y1="62" x2="234" y2="86" stroke="#38e8c6" stroke-width="0.8" opacity="0.55" />
      </g>

      {/* Cockpit windscreen — sloped front, dark tinted */}
      <path d="M 56 78 Q 60 66 80 62 L 100 62 L 100 78 Z" fill="#0a2540" opacity="0.45" />
      {/* Pilot/copilot window divider */}
      <line x1="78" y1="62" x2="80" y2="78" stroke="#0a2540" stroke-width="0.8" opacity="0.5" />

      {/* Cabin sliding door window — subtle outline */}
      <rect x="104" y="78" width="38" height="22" rx="1" fill="#0a2540" stroke="none" opacity="0.18" />
    </g>
  </svg>
  </div>
  {/* ════════ END SURFACE DECK ════════ */}

  {/* ════════ AIRBORNE DIRECTED-ENERGY — MQ-9 REAPER LASER STRAFE ════════
      An MQ-9B Reaper transits the full width of the upper sky band, chasing a
      UAV and lasing it on the fly — it never stops; the beam flickers on mid-
      pass and the UAV is killed while both keep moving. The aircraft, pod,
      laser, UAV and kill-flash all ride INSIDE one group, so the strafe
      geometry stays locked while the whole engagement flies across (the
      container does the travelling). It runs HIGH in the sky band, vertically
      clear of the surface combatant + HELIOS so the two engagements use
      different screen space. A script rerolls direction + altitude each pass
      (.bg-reaper-face flips the airframe to face its travel direction). Laser
      uses the directed-energy accent (#7fe3ff). */}
  <svg
    class="bg-reaper-engagement absolute"
    style="top: 0; left: 0; width: 400px; height: 230px; overflow: visible;"
    viewBox="0 0 400 230"
    preserveAspectRatio="xMidYMid meet"
  >
    {/* Direction wrapper — scaleX flips the whole engagement to face travel */}
    <g class="bg-reaper-face">
      {/* Chased UAV — ahead of the Reaper along its flight path */}
      <g class="bg-reaper-uav">
        <ellipse cx="300" cy="120" rx="7" ry="2.2" fill="#cfefff" opacity="0.85" />
        <path d="M 294 120 L 287 117 L 290 120 L 287 123 Z" fill="#cfefff" opacity="0.7" />
        <circle cx="307" cy="120" r="1.3" fill="#cfefff" opacity="0.75" />
      </g>

      {/* Strafe laser — bloom underlay + hot core, pod → UAV */}
      <line class="bg-reaper-laser bg-reaper-laser--bloom" x1="165" y1="76" x2="300" y2="120"
            stroke="#7fe3ff" stroke-width="4" stroke-linecap="round" />
      <line class="bg-reaper-laser bg-reaper-laser--core" x1="165" y1="76" x2="300" y2="120"
            stroke="#eafdff" stroke-width="1.4" stroke-linecap="round" />

      {/* Kill flash at the UAV */}
      <circle class="bg-reaper-flash" cx="300" cy="120" r="3" fill="#eafdff" />

      {/* MQ-9 Reaper airframe (side profile, nose right, level) — detailed for
          recognisability: humpbacked SATCOM nose fairing, chin MTS-B sensor
          ball, slender drooped fuselage, long wing with underwing munition +
          laser pods, down-canted inverted-V ruddervators, rear pusher prop. */}
      <g class="bg-reaper-air">
        <g fill="var(--color-teal, #38e8c6)" opacity="0.26">
          {/* Slender high-fineness fuselage — tail boom (left) to bulbous nose */}
          <path d="M 92 64 Q 98 61.5 136 60.5 L 178 60.5 Q 191 61.5 197 64 Q 191 66.5 178 67.5 L 136 67.5 Q 98 66.5 92 64 Z" />
          {/* Bulbous nose radome (rounded front) */}
          <path d="M 178 60 Q 197 59 198 64 Q 197 69 178 68 Z" />
          {/* SATCOM 'humpback' — single smooth dome just behind the nose (MQ-9 tell) */}
          <path d="M 153 61 Q 160 50.5 172 50.5 Q 180 51.5 180 61 Z" />
          {/* Dorsal engine-intake scoop — small distinct bump mid-rear (TPE331) */}
          <path d="M 116 61 Q 121 55 130 55.5 L 134 58 L 134 61 Z" />
          {/* Chin-mounted MTS-B EO/IR sensor turret under the nose */}
          <rect x="184" y="67" width="7" height="3" rx="1" />
          <circle cx="187" cy="71" r="4.2" />
          {/* Long wing at mid-fuselage, shallow dihedral, near edge-on */}
          <path d="M 104 64 L 146 62 L 188 64 L 188 65.5 L 146 63.5 L 104 65.5 Z" opacity="0.9" />
          {/* Inboard pylon + munition pod (e.g. Hellfire / GBU) */}
          <rect x="140" y="67.5" width="2" height="3.5" />
          <rect x="132" y="70.5" width="13" height="3" rx="1.5" opacity="0.85" />
          <path d="M 145 72 L 151 72 L 148 73.4 Z" opacity="0.85" />
          {/* Inverted-V ruddervators splaying down-out (Predator/Reaper signature) */}
          <path d="M 101 62 L 89 77 L 96 62 Z" />
          <path d="M 105 62 L 96 78 L 101 61 Z" />
          {/* Small dorsal fin where the ruddervators meet */}
          <path d="M 100 61 L 97 55 L 103 61 Z" />
          {/* Pusher-prop hub at the extreme tail */}
          <circle cx="85" cy="64" r="2.3" />
        </g>
        {/* Pusher propeller disc (reuses the scene's spin animation if present) */}
        <g class="bg-propeller-spin">
          <ellipse cx="83" cy="64" rx="1.5" ry="8.5" fill="var(--color-teal, #38e8c6)" opacity="0.5" />
          <line x1="83" y1="55.5" x2="83" y2="72.5" stroke="#38e8c6" stroke-width="0.8" opacity="0.6" />
        </g>
        {/* Outboard underwing laser pod + emitter aperture (charges → lases) */}
        <rect x="158" y="71.5" width="15" height="5" rx="1.5" fill="var(--color-teal, #38e8c6)" opacity="0.5" />
        <circle class="bg-reaper-pod" cx="165" cy="76" r="2.4" fill="#7fe3ff" />
      </g>
    </g>
  </svg>

  {/* ════════ UPPER PHOTIC BAND ════════ */}

  {/* OHIO class (SSGN/SSBN) — largest sub, missile deck. BOW RIGHT, STERN LEFT.
      Drifts RIGHT so the bow leads forward motion; bow sonar pings ahead. */}
  <svg
    class="bg-vessel bg-vessel-ohio absolute"
    style="top: 22%; left: -10%; width: 690px; height: 112px; overflow: visible;"
    viewBox="0 0 800 130"
    preserveAspectRatio="xMidYMid meet"
  >
    <g fill="var(--color-teal, #38e8c6)" opacity="0.18">
      {/* Long teardrop hull (bow right, stern left) */}
      <path d="M 690 65 Q 670 28 590 24 L 120 24 Q 50 28 20 65 Q 50 102 120 106 L 590 106 Q 670 102 690 65 Z" />
      {/* Sail with sail-mounted dive planes */}
      <path d="M 520 24 Q 516 4 488 2 L 400 2 Q 372 4 366 24 Z" />
      <rect x="388" y="14" width="100" height="4" rx="1" />
      <rect x="450" y="-4" width="2" height="8" />
      <rect x="435" y="-3" width="2" height="7" />
      {/* Missile deck (24 SLBM tubes, simplified to 8 hatches) */}
      <rect x="110" y="20" width="240" height="4" opacity="0.30" />
      <ellipse cx="135" cy="22" rx="6" ry="3" opacity="0.55" />
      <ellipse cx="163" cy="22" rx="6" ry="3" opacity="0.55" />
      <ellipse cx="191" cy="22" rx="6" ry="3" opacity="0.55" />
      <ellipse cx="219" cy="22" rx="6" ry="3" opacity="0.55" />
      <ellipse cx="247" cy="22" rx="6" ry="3" opacity="0.55" />
      <ellipse cx="275" cy="22" rx="6" ry="3" opacity="0.55" />
      <ellipse cx="303" cy="22" rx="6" ry="3" opacity="0.55" />
      <ellipse cx="331" cy="22" rx="6" ry="3" opacity="0.55" />
      {/* Cruciform tail X-fins at stern (left side) */}
      <path d="M 20 65 L 2 36 L 8 60 Z" />
      <path d="M 20 65 L 2 94 L 8 70 Z" />
      <path d="M 20 65 L 8 50 L 8 58 Z" />
      <path d="M 20 65 L 8 80 L 8 72 Z" />
      {/* Pump-jet propulsor with spinning blades */}
      <circle cx="10" cy="65" r="4" />
      <g class="bg-propeller-spin">
        <ellipse cx="10" cy="65" rx="2" ry="10" opacity="0.5" />
        <line x1="10" y1="55" x2="10" y2="75" stroke="#38e8c6" stroke-width="0.8" opacity="0.6" />
      </g>
      {/* Bow sonar dome (forward of pressure hull) */}
      <ellipse cx="688" cy="65" rx="4" ry="9" opacity="0.55" />
    </g>
    {/* Active forward-looking sonar — long fan beam projecting ahead of the bow
        dome, gently pulsing. Extends past the viewBox (svg overflow:visible). */}
    <g class="bg-sub-sonar">
      <path d="M 690 56 L 916 18 L 916 112 L 690 74 Z" fill="var(--color-teal, #38e8c6)" opacity="0.16" />
    </g>
    {/* Sonar return arcs — staggered expanding wavefronts marching forward from
        the bow, convex toward the bearing of travel */}
    <g fill="none" stroke="var(--color-teal, #38e8c6)" stroke-width="1.6" stroke-linecap="round">
      <path class="bg-sub-arc bg-sub-arc-1" d="M 726 50 Q 736 65 726 80" opacity="0" />
      <path class="bg-sub-arc bg-sub-arc-2" d="M 774 42 Q 788 65 774 88" opacity="0" />
      <path class="bg-sub-arc bg-sub-arc-3" d="M 824 34 Q 842 65 824 96" opacity="0" />
      <path class="bg-sub-arc bg-sub-arc-4" d="M 874 26 Q 896 65 874 104" opacity="0" />
    </g>
  </svg>

  {/* Lightweight torpedo (Mk54-style) — nose forward (right), cavitation trail
      behind, active sonar fan beam projecting ahead */}
  <svg
    class="bg-vessel bg-vessel-torpedo-lw absolute"
    style="top: 32%; left: -12%; width: 340px; height: 45px;"
    viewBox="0 0 380 50"
    preserveAspectRatio="xMidYMid meet"
  >
    {/* Cavitation bubble trail (trailing behind tail) */}
