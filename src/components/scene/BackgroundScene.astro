{/* ── HELRAS active acoustic wavefronts — rendered as a sibling of the scene
    so it can sit ABOVE the page content (the scene itself is trapped below
    content by its own opacity stacking context). Mirrors the helicopter SVG's
    position/geometry exactly, then statically drops the wave group to the
    deployed transducer depth (translateY --dip). mix-blend-mode:screen makes
    the teal glow over the dark background while leaving the light body text
    essentially untouched; pointer-events:none keeps it non-interactive. The
    helo-active-gate keeps it visible only during the on-station ping window.
    Hidden on the directed-energy variant (it belongs to the dipping-sonar helo,
    which that variant drops). */}
{variant !== "directed-energy" && (
<div class="helras-wave-layer" aria-hidden="true">
  <svg
    class="helras-wave-svg"
    viewBox="0 0 240 580"
    preserveAspectRatio="xMidYMid meet"
  >
    <g class="helras-wave-deployed">
      <g class="bg-helo-active" fill="none" stroke="var(--color-teal, #38e8c6)">
        {/* Ensonified beam cone — faint filled downward fan from the projector */}
        <path class="bg-helo-cone" d="M 102 150 L 78 250 L 142 250 L 118 150 Z" fill="var(--color-teal, #38e8c6)" stroke="none" opacity="0.07" />
        <path class="bg-ping-out bg-ping-out-1" d="M 106 150 A 4 4 0 0 0 114 150" stroke-width="1.6" />
        <path class="bg-ping-out bg-ping-out-2" d="M 106 150 A 4 4 0 0 0 114 150" stroke-width="1.4" />
        <path class="bg-ping-out bg-ping-out-3" d="M 106 150 A 4 4 0 0 0 114 150" stroke-width="1.3" />
        <path class="bg-ping-out bg-ping-out-4" d="M 106 150 A 4 4 0 0 0 114 150" stroke-width="1.1" />
        <path class="bg-echo-in bg-echo-in-1" d="M 106 150 A 4 4 0 0 0 114 150" stroke-width="1.2" stroke-dasharray="3 5" />
        <path class="bg-echo-in bg-echo-in-2" d="M 106 150 A 4 4 0 0 0 114 150" stroke-width="1" stroke-dasharray="3 5" />
      </g>
    </g>
  </svg>
</div>
)}

<style>
  :global(body) {
    position: relative;
  }

  .background-scene {
    contain: paint;
    /* Dim the entire scene so vessels read as ATMOSPHERE not foreground.
       Brightens slightly when user actively engages (no animation cost). */
    opacity: 0.55;
  }

  /* ─── Directed-energy variant ───
     Drop the subsea fleet + seabed + dipping-sonar helo so the directed-energy
     engagements (surface HELIOS + airborne Reaper strafe) carry the scene on
     the /directed-energy page. The destroyer (HELIOS host), Reaper, water
     surface, caustics and depth gradient stay. */
  .scene-de .bg-vessel-ohio,
  .scene-de .bg-vessel-torpedo-lw,
  .scene-de .bg-vessel-virginia,
  .scene-de .bg-vessel-torpedo-hw,
  .scene-de .bg-vessel-la,
  .scene-de .bg-vessel-marlin,
  .scene-de .bg-vessel-xluuv,
  .scene-de .bg-vessel-mduuv,
  .scene-de .bg-vessel-manta,
  .scene-de .bg-vessel-sonar-uuv,
  .scene-de .bg-vessel-seabed,
  .scene-de .bg-vessel-helo {
    display: none;
  }

  /* ─── Surface deck — shared coordinate frame for waterline + ship + helo.
     One absolutely-positioned wrapper; its children use fixed deck-local
     pixels so the hull, the surface line, and the dipped transducer stay
     aligned regardless of viewport/document height (fixes the mobile dip
     stopping above the waterline). ─── */
  .surface-deck {
    position: absolute;
    top: 4%;
    left: 0;
    right: 0;
    height: 400px;
  }
  /* Pin the water surface inside the deck (overrides the component's own
     top:7%) so the waterline sits at a known deck-local y the dip targets. */
  .surface-deck :global(.water-surface) {
    top: 150px;
  }

  /* ─── HELRAS wave overlay — mirrors the deck + helicopter positioning but
     lives ABOVE the page content so the active wavefronts read over the
     About-section background. screen blend = teal glows on the dark field,
     light text stays legible; pointer-events:none keeps it inert. ─── */
  .helras-wave-layer {
    --dip: 300px;
    position: absolute;
    top: 4%;
    left: 0;
    right: 0;
    height: 400px;
    z-index: 8; /* below main content so pings cannot wash over body copy */
    pointer-events: none;
    mix-blend-mode: screen;
    opacity: 0.72;
  }
  .helras-wave-svg {
    position: absolute;
    top: -28px;
    right: 6%;
    width: 200px;
    height: 480px;
    overflow: visible;
  }
  /* Statically drop the wave group to the deployed transducer depth (the
     in-scene rig descends to the same translateY(--dip)). */
  .helras-wave-deployed {
    transform-box: fill-box;
    transform-origin: top center;
    transform: translateY(var(--dip, 300px));
  }

  /* ─── Depth gradient (bottom darkness reduced from 0.72 → 0.65) ─── */
  .bg-depth-gradient {
    background: linear-gradient(
      to bottom,
      rgba(20, 45, 70, 0.20) 0%,
      rgba(12, 30, 52, 0.12) 16%,
      rgba(6, 18, 36, 0.06) 35%,
      rgba(2, 10, 22, 0.16) 60%,
      rgba(0, 4, 10, 0.46) 85%,
      rgba(0, 0, 0, 0.65) 100%
    );
  }

  /* ─── General vessel base ─── */
  .bg-vessel {
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  /* ─── Drift animations ─── */
  .bg-vessel-ship       { animation: drift-right 110s linear infinite; }
  .bg-vessel-ohio       { animation: drift-right 180s linear infinite; }
  .bg-vessel-torpedo-lw { animation: drift-right 32s linear infinite; animation-delay: -8s; }
  .bg-vessel-virginia   { animation: drift-right 155s linear infinite; }
  .bg-vessel-torpedo-hw { animation: drift-right 38s linear infinite; animation-delay: -22s; }
  .bg-vessel-la         { animation: drift-left 150s linear infinite; }
  .bg-vessel-marlin     { animation: drift-left 130s linear infinite; }
  .bg-vessel-xluuv      { animation: drift-right 165s linear infinite; }
  .bg-vessel-mduuv      { animation: drift-right 140s linear infinite; }
  .bg-vessel-manta      { animation: drift-right 175s linear infinite; }
  /* Bottom-scanning UUV — drifts across the seabed while pinging (slow survey transit) */
  .bg-vessel-sonar-uuv  { animation: drift-right 95s linear infinite; }

  /* ─── Sonar ping animation (faster cadence) ─── */
  .bg-sonar-beam {
    animation: sonar-pulse 1.6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: top center;
  }
  @keyframes sonar-pulse {
    0%, 100% { opacity: 0.6; }
    50%      { opacity: 1; }
  }

  /* Sonar return arcs — staggered expanding pings (bottom UUV) */
  .bg-sonar-arc {
    animation: sonar-arc 1.6s ease-out infinite;
  }
  .bg-sonar-arc-1 { animation-delay: 0s; }
  .bg-sonar-arc-2 { animation-delay: 0.2s; }
  .bg-sonar-arc-3 { animation-delay: 0.4s; }
  @keyframes sonar-arc {
    0%   { opacity: 0; }
    20%  { opacity: 0.55; }
    100% { opacity: 0; }
  }

  /* ─── Ohio bow sonar — long forward fan that gently pulses, plus return arcs
     that march outward from the bow (slower, stately cadence to suit the big
     boat). More opaque than the old static cone. ─── */
  .bg-sub-sonar {
    transform-box: fill-box;
    transform-origin: left center;
    animation: sub-sonar-pulse 2.4s ease-in-out infinite;
  }
  @keyframes sub-sonar-pulse {
    0%, 100% { opacity: 0.13; }
    50%      { opacity: 0.24; }
  }
  /* Return arcs — staggered fade reads as wavefronts travelling forward */
  .bg-sub-arc {
    animation: sub-arc 2.4s ease-out infinite;
  }
  .bg-sub-arc-1 { animation-delay: 0s; }
  .bg-sub-arc-2 { animation-delay: 0.45s; }
  .bg-sub-arc-3 { animation-delay: 0.9s; }
  .bg-sub-arc-4 { animation-delay: 1.35s; }
  @keyframes sub-arc {
    0%   { opacity: 0; }
    25%  { opacity: 0.7; }
    100% { opacity: 0; }
  }

  /* ─── Torpedo sonar — faster cadence (terminal-attack ping rate) ───
     The forward swath both pulses (ping cadence) AND steers: the beam sweeps
     up/down through angles, pivoting at the nose, to read as an electronically
     beam-steered phased array scanning ahead rather than a fixed cone. */
  .bg-torp-sonar {
    transform-box: fill-box;
    transform-origin: left center;
    animation:
      torp-sonar-pulse 1.1s ease-in-out infinite,
      torp-beam-steer 3.4s ease-in-out infinite;
  }
  @keyframes torp-sonar-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 1; }
  }
  @keyframes torp-beam-steer {
    0%, 100% { rotate: -16deg; }
    50%      { rotate: 16deg; }
  }

  /* ─── HELIOS directed-energy engagement (surface ship) ───
     Four threats, four bearings — two forward, two aft. Each engagement shares
     one 9s set of keyframes (target inbound → aperture charges → beam fires
     with a sustained-lase flicker → kill flash → quiet reset) and is
     phase-shifted a quarter of the cycle via --de-delay, so a shot lands
     ~every 2.25s, alternating front and back as the ship transits. Beam glows
     via a wide low-opacity bloom line under a hot near-white core. */
  .bg-de-eng--1 { --de-delay: 0s; }
  .bg-de-eng--2 { --de-delay: -2.25s; }
  .bg-de-eng--3 { --de-delay: -4.5s; }
  .bg-de-eng--4 { --de-delay: -6.75s; }

  .bg-de-beam {
    opacity: 0;
    filter:
      drop-shadow(0 0 4px rgb(127 227 255 / 0.95))
      drop-shadow(0 0 10px rgb(127 227 255 / 0.45));
    animation: de-fire 9s linear infinite;
    animation-delay: var(--de-delay, 0s);
  }
  .bg-de-beam--bloom { opacity: 0; }
  @keyframes de-fire {
    0%, 29%  { opacity: 0; }
    30%      { opacity: 0.7; }
    31%      { opacity: 0.35; }
    32.5%    { opacity: 0.72; }
    36%      { opacity: 0.45; }
    38%      { opacity: 0.7; }
    43%      { opacity: 0.55; }
    45%      { opacity: 0; }
    100%     { opacity: 0; }
  }

  .bg-de-target {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: de-target 9s ease-in infinite;
    animation-delay: var(--de-delay, 0s);
  }
  @keyframes de-target {
    0%   { opacity: 0; transform: translate(70px, -30px); }
    8%   { opacity: 0.7; }
    29%  { opacity: 0.8; transform: translate(0, 0); }
    44%  { opacity: 0.9; transform: translate(0, 0); }
    46%  { opacity: 0; transform: translate(2px, 6px); }
    100% { opacity: 0; transform: translate(70px, -30px); }
  }

  .bg-de-flash {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    filter: drop-shadow(0 0 6px rgb(234 253 255 / 0.9));
    animation: de-flash 9s ease-out infinite;
    animation-delay: var(--de-delay, 0s);
  }
  @keyframes de-flash {
    0%, 31% { opacity: 0; transform: scale(0.3); }
    38%     { opacity: 0.95; transform: scale(1.1); }
    46%     { opacity: 0; transform: scale(2.2); }
    100%    { opacity: 0; transform: scale(0.3); }
  }

  /* Shared aperture pulses once per ~2.25s shot (independent of the 9s
     per-engagement period) so the turret reads as charging before each lase. */
  .bg-de-aperture {
    filter: drop-shadow(0 0 3px rgb(127 227 255 / 0.8));
    animation: de-aperture 2.25s ease-in-out infinite;
  }
  @keyframes de-aperture {
    0%   { opacity: 0.4; }
    28%  { opacity: 1; }
    45%  { opacity: 0.6; }
    100% { opacity: 0.4; }
  }

  /* ─── MQ-9 Reaper airborne laser strafe ───
     22s loop: the whole engagement (airframe + pod + laser + UAV + flash) rides
     one group and the CONTAINER flies it across the full width of the upper sky
     band — continuous motion, never stopping. The laser flickers on mid-pass
     (~42–56%) and the UAV is killed while both keep moving; the strafe geometry
     stays locked because everything travels together. Flight direction +
     altitude are CSS vars a script rerolls each pass (defaults below keep it
     flying with no JS / before hydration). */
  .bg-reaper-engagement {
    --rfly-x0: -34vw;
    --rfly-y0: 4px;
    --rfly-x1: 134vw;
    --rfly-y1: 30px;
    will-change: transform;
    animation: reaper-flyby 22s linear infinite;
  }
  @keyframes reaper-flyby {
    0%   { transform: translate3d(var(--rfly-x0), var(--rfly-y0), 0); opacity: 0; }
    8%   { opacity: 1; }
    92%  { opacity: 1; }
    100% { transform: translate3d(var(--rfly-x1), var(--rfly-y1), 0); opacity: 0; }
  }

  /* scaleX flips the airframe to face its travel direction (set by the script) */
  .bg-reaper-face {
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleX(var(--rfly-face, 1));
  }

  .bg-reaper-laser {
    opacity: 0;
    filter:
      drop-shadow(0 0 4px rgb(127 227 255 / 0.95))
      drop-shadow(0 0 9px rgb(127 227 255 / 0.45));
    animation: reaper-laser 22s linear infinite;
  }
  .bg-reaper-laser--bloom { opacity: 0; }
  @keyframes reaper-laser {
    0%, 41% { opacity: 0; }
    42%     { opacity: 0.7; }
    44%     { opacity: 0.4; }
    46%     { opacity: 0.75; }
    49%     { opacity: 0.45; }
    52%     { opacity: 0.7; }
    56%     { opacity: 0; }
    100%    { opacity: 0; }
  }

  .bg-reaper-uav {
    opacity: 0;
    animation: reaper-uav 22s ease-out infinite;
  }
  @keyframes reaper-uav {
    0%, 12% { opacity: 0; }
    18%     { opacity: 0.85; }
    52%     { opacity: 0.9; }
    55%     { opacity: 0; }
    100%    { opacity: 0; }
  }

  .bg-reaper-flash {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    filter: drop-shadow(0 0 6px rgb(234 253 255 / 0.9));
    animation: reaper-flash 22s ease-out infinite;
  }
  @keyframes reaper-flash {
    0%, 52% { opacity: 0; transform: scale(0.3); }
    55%     { opacity: 0.95; transform: scale(1.1); }
    60%     { opacity: 0; transform: scale(2.2); }
    100%    { opacity: 0; transform: scale(0.3); }
  }

  .bg-reaper-pod {
    filter: drop-shadow(0 0 3px rgb(127 227 255 / 0.8));
    animation: reaper-pod 22s ease-in-out infinite;
  }
  @keyframes reaper-pod {
    0%, 36% { opacity: 0.4; }
    42%     { opacity: 1; }
    56%     { opacity: 0.6; }
    62%     { opacity: 0.4; }
    100%    { opacity: 0.4; }
  }

  .bg-torp-arc {
    animation: torp-arc 1.1s ease-out infinite;
  }
  .bg-torp-arc-1 { animation-delay: 0s; }
  .bg-torp-arc-2 { animation-delay: 0.18s; }
  .bg-torp-arc-3 { animation-delay: 0.36s; }
  @keyframes torp-arc {
    0%   { opacity: 0; }
    25%  { opacity: 0.65; }
    100% { opacity: 0; }
  }

  /* Torpedo sonar arcs — staggered expanding pings (forward from nose) */
  .bg-torp-arc {
    animation: torp-arc 2.2s ease-out infinite;
  }
  .bg-torp-arc-1 { animation-delay: 0s; }
  .bg-torp-arc-2 { animation-delay: 0.3s; }
  .bg-torp-arc-3 { animation-delay: 0.6s; }
  @keyframes torp-arc {
    0%   { opacity: 0; }
    25%  { opacity: 0.65; }
    100% { opacity: 0; }
  }

  @keyframes drift-right {
    0%   { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(130vw, 0, 0); }
  }
  @keyframes drift-left {
    0%   { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-130vw, 0, 0); }
  }

  /* ═══════════════════════════════════════════════════════════════════════
     HELICOPTER + HELRAS DEPLOYMENT CHOREOGRAPHY (90s loop — fast deploy, quick exit)
     ═══════════════════════════════════════════════════════════════════════ */

  /* Phase 1: helicopter container flies in/out horizontally */
  .bg-vessel-helo {
    /* Deployed tether length. --dip is the rig's descent in screen px; the
       cable rect (height 300) is scaled by --cable-scale to match. Overridden
       on mobile (see media query) to drop the sonar ~25% deeper. */
    --dip: 300px;
    --cable-scale: 1;
    animation: helo-flyby 90s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes helo-flyby {
    /* vw units (not %) so the helicopter fully clears the viewport — % is
       relative to the element's own 200px width and only moved it ~440px,
       parking it mid-screen instead of off it. */
    0%        { transform: translate3d(120vw, 0, 0); }    /* off-screen right */
    5%        { transform: translate3d(0, 0, 0); }         /* arrived (fast) */
    48%       { transform: translate3d(0, 0, 0); }         /* on station through deploy + retract */
    60%, 100% { transform: translate3d(-120vw, 0, 0); }    /* fully off-screen left, stays off until next cycle */
  }

  /* Phase 2: cable extends as sonar descends */
  .bg-helo-cable {
    transform-box: fill-box;
    transform-origin: top center;
    transform: scaleY(0);
    opacity: 0;
    animation: cable-extend 90s linear infinite;
  }
  @keyframes cable-extend {
    0%, 5%    { transform: scaleY(0); opacity: 0; }
    6%        { opacity: 1; }
    14%       { transform: scaleY(var(--cable-scale, 1)); opacity: 1; }
    40%       { transform: scaleY(var(--cable-scale, 1)); opacity: 1; }
    47%       { opacity: 1; }
    48%, 100% { transform: scaleY(0); opacity: 0; }
  }

  /* Phase 3: sonar rig descends along the cable */
  .bg-helo-sonar-rig {
    transform-box: fill-box;
    transform-origin: top center;
    transform: translateY(0);
    opacity: 0;
    animation: sonar-descent 90s linear infinite;
  }
  @keyframes sonar-descent {
    0%, 5%    { transform: translateY(0); opacity: 0; }
    6%        { opacity: 1; }
    14%       { transform: translateY(var(--dip, 300px)); opacity: 1; }
    40%       { transform: translateY(var(--dip, 300px)); opacity: 1; }
    47%       { opacity: 1; }
    48%, 100% { transform: translateY(0); opacity: 0; }
  }

  /* Phase 5: 3 hydrophone plates drop, hold, retract */
  .bg-helo-plate {
    transform-box: fill-box;
    transform-origin: top center;
    transform: translateY(0);
    opacity: 0;
    animation: plate-drop 90s linear infinite;
  }
  @keyframes plate-drop {
    0%, 20%   { transform: translateY(0); opacity: 0; }
    22%       { transform: translateY(0); opacity: 0.75; }
    24%, 30%  { transform: translateY(18px); opacity: 0.75; }
    33%       { transform: translateY(0); opacity: 0.75; }
    34%, 100% { transform: translateY(0); opacity: 0; }
  }

  /* ─── HELRAS active transmit / return wavefronts ───
     A 90s "gate" reveals the whole group only while the array is deployed
     and pinging (~16–40% of the cycle); inside, each ring runs its own fast
     ~2.4s loop so the ping cadence reads as continuous active operation. */
  .bg-helo-active {
    opacity: 0;
    animation: helo-active-gate 90s linear infinite;
  }
  @keyframes helo-active-gate {
    0%, 15%   { opacity: 0; }
    18%       { opacity: 1; }
    38%       { opacity: 1; }
    41%, 100% { opacity: 0; }
  }

  /* Outgoing ping — semicircular wavefronts expand DOWNWARD from the
     projector toward the seabed. Anchored at the flat top edge (the
     transducer) so they grow downward/outward, not from their own centre. */
  .bg-ping-out {
    transform-box: fill-box;
    transform-origin: center top;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    animation: helo-ping-out 2.6s ease-out infinite;
  }
  .bg-ping-out-1 { animation-delay: 0s; }
  .bg-ping-out-2 { animation-delay: 0.65s; }
  .bg-ping-out-3 { animation-delay: 1.3s; }
  .bg-ping-out-4 { animation-delay: 1.95s; }
  @keyframes helo-ping-out {
    0%   { transform: translateY(0) scale(0.6); opacity: 0; }
    12%  { opacity: 0.9; }
    100% { transform: translateY(98px) scale(11); opacity: 0; }
  }

  /* Ensonified cone — gently breathes while the array is active */
  .bg-helo-cone {
    transform-box: fill-box;
    transform-origin: center top;
    animation: helo-cone-pulse 2.6s ease-in-out infinite;
  }
  @keyframes helo-cone-pulse {
    0%, 100% { opacity: 0.04; }
    50%      { opacity: 0.09; }
  }

  /* Return echo — semicircular wavefronts collapse back UP to the transducer,
     delayed so they read as the reflection returning after bouncing off the
     bottom. Same downward arc, anchored at the same top edge. */
  .bg-echo-in {
    transform-box: fill-box;
    transform-origin: center top;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    animation: helo-echo-in 2.6s ease-in infinite;
  }
  .bg-echo-in-1 { animation-delay: 1.3s; }
  .bg-echo-in-2 { animation-delay: 2.0s; }
  @keyframes helo-echo-in {
    0%   { transform: translateY(90px) scale(9); opacity: 0; }
    35%  { opacity: 0; }
    55%  { opacity: 0.5; }
    100% { transform: translateY(0) scale(0.8); opacity: 0; }
  }

  /* ─── Caustics shimmer ─── */
  .bg-caustics {
    animation: caustics-shimmer 14s ease-in-out infinite;
    transform-origin: 50% 0%;
  }
  @keyframes caustics-shimmer {
    0%, 100% { transform: scaleY(1);    opacity: 0.05; }
    50%      { transform: scaleY(1.08); opacity: 0.08; }
  }

  /* ─── Reduced motion: freeze in mid-deployment, no drift ─── */
  @media (prefers-reduced-motion: reduce) {
    .bg-vessel,
    .bg-caustics,
    .bg-helo-cable,
    .bg-helo-sonar-rig,
    .bg-helo-plate {
      animation: none;
    }
    .bg-vessel-ship       { transform: translate3d(45vw, 0, 0); }
    .bg-vessel-ohio       { transform: translate3d(45vw, 0, 0); }
    .bg-vessel-torpedo-lw { transform: translate3d(60vw, 0, 0); }
    .bg-vessel-virginia   { transform: translate3d(40vw, 0, 0); }
    .bg-vessel-torpedo-hw { transform: translate3d(50vw, 0, 0); }
    .bg-vessel-la         { transform: translate3d(-50vw, 0, 0); }
    .bg-vessel-marlin     { transform: translate3d(-45vw, 0, 0); }
    .bg-vessel-xluuv      { transform: translate3d(40vw, 0, 0); }
    .bg-vessel-mduuv      { transform: translate3d(40vw, 0, 0); }
    .bg-vessel-manta      { transform: translate3d(35vw, 0, 0); }
    .bg-vessel-sonar-uuv  { transform: translate3d(40vw, 0, 0); }
    /* Pings frozen mid-cycle for visual interest */
    .bg-sonar-beam        { opacity: 0.85; animation: none; }
    .bg-sonar-arc         { opacity: 0.45; animation: none; }
    .bg-sub-sonar         { opacity: 0.22; animation: none; }
    .bg-sub-arc           { opacity: 0.5; animation: none; }
    .bg-torp-sonar        { opacity: 0.85; animation: none; }
    .bg-torp-arc          { opacity: 0.55; animation: none; }
    /* Helicopter parked on-station with sonar fully deployed for visual interest */
    .bg-vessel-helo       { transform: translate3d(0, 0, 0); }
    .bg-helo-cable        { transform: scaleY(var(--cable-scale, 1)); opacity: 1; }
    .bg-helo-sonar-rig    { transform: translateY(var(--dip, 300px)); opacity: 1; }
    .bg-helo-plate        { transform: translateY(0); opacity: 0; }
    /* Active sonar frozen mid-ping: one outgoing wavefront + one return */
    .bg-helo-active       { opacity: 1; animation: none; }
    .bg-helo-cone         { animation: none; opacity: 0.06; }
    .bg-ping-out          { animation: none; opacity: 0; }
    .bg-ping-out-2        { opacity: 0.5; transform: translateY(35px) scale(4); }
    .bg-ping-out-3        { opacity: 0.2; transform: translateY(75px) scale(8); }
    .bg-echo-in           { animation: none; opacity: 0; }
    .bg-echo-in-1         { opacity: 0.35; transform: translateY(50px) scale(5); }
    /* HELIOS engagements frozen mid-lase: beams locked on the inbound targets */
    .bg-de-beam           { animation: none; opacity: 0.9; }
    .bg-de-target         { animation: none; opacity: 0.8; transform: translate(0, 0); }
    .bg-de-flash          { animation: none; opacity: 0; }
    .bg-de-aperture       { animation: none; opacity: 1; }
    /* Reaper frozen mid-strafe over the screen: engagement parked mid-pass,
       laser locked on the UAV */
    .bg-reaper-engagement { animation: none; opacity: 1; transform: translate3d(42vw, 12px, 0); }
    .bg-reaper-laser      { animation: none; opacity: 0.85; }
    .bg-reaper-uav        { animation: none; opacity: 0.85; }
    .bg-reaper-flash      { animation: none; opacity: 0; }
    .bg-reaper-pod        { animation: none; opacity: 1; }
  }

  /* ─── Mobile: drop the dipping sonar ~25% deeper (300px → 375px) and place
     the ship / water surface at the MIDPOINT of the fully deployed tether.
     Tether top sits ~68px (deck-local) below the deck origin; with the deeper
     dip the transducer reaches ~378px, so the midpoint is ~223px. The destroyer
     keeps its same surface-relative offset. Desktop is untouched. Placed at the
     end of the sheet so these override the base .bg-vessel-helo --dip (equal
     specificity → source order decides). ─── */
  @media (max-width: 640px) {
    .bg-vessel-helo {
      --dip: 375px;
      --cable-scale: 1.25;
    }
    /* keep the overlay waves at the same deepened transducer depth */
    .helras-wave-layer {
      --dip: 375px;
    }
    .surface-deck :global(.water-surface) {
      top: 223px;
    }
    .bg-vessel-ship {
      top: 165px !important;
    }
  }
</style>

<script>
  // Vary the Reaper's flight each pass: direction (L→R or R→L) and altitude /
  // slope. The flyby keyframes read --rfly-x0/x1/y0/y1 on the container and
  // --rfly-face on the airframe wrapper. We reroll on every animation iteration
  // (while the drone is off-frame at opacity 0), so it crosses the upper band at
  // a different height / from a different side each time. The container does the
  // travelling — the airframe + laser + UAV ride along, so the strafe stays
  // locked while everything keeps moving.
  const reaper = document.querySelector<SVGElement>(".bg-reaper-engagement");
  const face = document.querySelector<SVGGElement>(".bg-reaper-face");
  if (reaper && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const OFF_L = "-34vw";
    const OFF_R = "134vw";
    const alts = [2, 16, 30, 46, 60]; // entry/exit altitude options (px from top)
    const pick = (len: number, not: number) => {
      let i = not;
      while (i === not && len > 1) i = Math.floor(Math.random() * len);
      return i;
    };
    let lastDir = -1;
    let lastY = -1;
    const reroll = () => {
      const dir = pick(2, lastDir); // 0 = L→R, 1 = R→L
      lastDir = dir;
      const y0i = pick(alts.length, lastY);
      lastY = y0i;
      const y1i = pick(alts.length, y0i);
      reaper.style.setProperty("--rfly-x0", dir === 0 ? OFF_L : OFF_R);
      reaper.style.setProperty("--rfly-x1", dir === 0 ? OFF_R : OFF_L);
      reaper.style.setProperty("--rfly-y0", `${alts[y0i]}px`);
      reaper.style.setProperty("--rfly-y1", `${alts[y1i]}px`);
      // Face travel direction: airframe drawn nose-right, so mirror for R→L.
      face?.style.setProperty("--rfly-face", dir === 0 ? "1" : "-1");
    };
    reroll();
    reaper.addEventListener("animationiteration", (e) => {
      if ((e as AnimationEvent).animationName === "reaper-flyby") reroll();
    });
  }
</script>
