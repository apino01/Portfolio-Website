---
import { Picture } from "astro:assets";
import headshot from "~/assets/headshot.jpg";
import AvailabilityBadge from "./AvailabilityBadge.astro";
import SideNav from "~/components/nav/SideNav.astro";
import IconLink from "~/components/ui/IconLink.astro";
import LinkedInIcon from "~/components/ui/icons/LinkedInIcon.astro";
import DocumentIcon from "~/components/ui/icons/DocumentIcon.astro";
const navItems = [
  { id: "about", label: "About" },
  { id: "experience", label: "Experience" },
  { id: "projects", label: "Projects" },
  { id: "services", label: "Services", href: "/services/" },
  { id: "contact", label: "Contact" },
];
---

<header
  class="flex flex-col gap-10 lg:sticky lg:top-0 lg:flex h-auto lg:h-dvh lg:max-h-dvh lg:py-24"
>
  <div class="hero-stagger flex flex-col gap-6">
    <AvailabilityBadge />

    <div class="flex items-center gap-5">
      <span class="headshot-ping inline-block h-20 w-20 shrink-0">
        <Picture
          src={headshot}
          alt="Portrait of Andrés Pino"
          width={160}
          height={160}
          densities={[1, 2]}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          loading="eager"
          class="h-20 w-20 rounded-full border border-teal/25 object-cover shadow-[0_0_0_5px_rgb(6_26_44/_0.7)]"
        />
      </span>
      <div class="min-w-0 max-w-[13.5rem] sm:max-w-none">
        <h1 class="text-3xl font-semibold tracking-tight text-near-white sm:text-4xl">
          Andrés Pino
        </h1>
        <p class="mt-1 max-w-full text-base leading-snug text-light-slate">
          Engineering Advisor — Defense &amp; Maritime Hardware
        </p>
      </div>
    </div>

    {/* Offer-first positioning: what the visitor gets, then the credibility
        that backs it. Job-title framing lives in About and Experience. */}
    <p class="max-w-md leading-relaxed text-slate">
      I help defense and maritime teams get hard hardware right — system
      architecture, power electronics, sonar, and undersea autonomy. Twenty
      years carrying programs from concept through integration, test, and
      fleet delivery, now advising teams that need that judgment on demand.
    </p>

    {/* Single-line trust anchor — buyer-facing authority signal */}
    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate/85">
      <span class="text-teal/85">Programs delivered for:</span>
      General Atomics · L3Harris · Lockheed Martin<br />
      Terradepth · U.S. Navy
    </p>

    <p class="font-mono text-xs uppercase tracking-widest text-slate/80">
      Active TS Clearance · San Diego, CA
    </p>

    {/* CTA pair — primary routes to the offer (what engagements look like),
        secondary goes straight to contact for visitors who already know. */}
    <div class="hero-cta flex flex-wrap items-center gap-3">
      <a
        href="/services/"
        class="group inline-flex min-h-[44px] w-fit items-center gap-2 rounded-md border border-teal/50 bg-teal/15 px-4 py-2 font-mono text-sm text-teal transition-colors hover:bg-teal/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal"
      >
        How I can help
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
      <a
        href="#contact"
        class="group inline-flex min-h-[44px] w-fit items-center gap-2 rounded-md border border-slate/30 px-4 py-2 font-mono text-sm text-light-slate transition-colors hover:border-teal/40 hover:text-teal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal"
      >
        Send a note
        <span aria-hidden="true" class="transition-transform group-hover:translate-y-0.5">↓</span>
      </a>
    </div>
  </div>

  <SideNav items={navItems} />

  {/* Mobile-only inline section jumplist */}
  <nav aria-label="Page sections" class="lg:hidden">
    <ul class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href ?? `#${item.id}`}
              class="inline-flex min-h-[44px] w-full items-center justify-center rounded-full border border-slate/20 px-4 py-2 font-mono text-xs uppercase tracking-widest text-slate hover:border-teal/40 hover:text-teal sm:w-auto"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <ul class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2" aria-label="Documents and social">
    <li>
      {/* Buyer-facing leave-behind — the standard artifact in defense
          contracting; sits ahead of the résumé for that reason. */}
      <a
        href="/andres-pino-capability-statement.pdf"
        class="group inline-flex min-h-[44px] items-center gap-1.5 font-mono text-xs uppercase tracking-[0.18em] text-light-slate hover:text-teal"
      >
        <DocumentIcon />
        <span>Capability Statement</span>
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">↗</span>
      </a>
    </li>
    <li>
      <a
        href="/andres-pino-resume.pdf"
        class="group inline-flex min-h-[44px] items-center gap-1.5 font-mono text-xs uppercase tracking-[0.18em] text-light-slate hover:text-teal"
      >
        <DocumentIcon />
        <span>Résumé (PDF)</span>
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">↗</span>
      </a>
    </li>
    <li>
      <IconLink
        href="https://www.linkedin.com/in/andresmpino/"
        label="LinkedIn profile"
      >
        <LinkedInIcon />
      </IconLink>
    </li>
  </ul>
</header>
