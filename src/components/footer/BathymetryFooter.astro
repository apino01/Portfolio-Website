---
// Footer styled as a bathymetric chart — depth contour lines + site nav.
const year = new Date().getFullYear();
---

<footer class="bathy-footer relative mt-24 overflow-hidden">
  {/* Depth contour SVG — bathymetric chart aesthetic (curves only; depth
      labels live in HTML below so they scale responsively on mobile). */}
  <svg
    class="bathy-contours pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 1200 240"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <g fill="none" stroke="var(--color-teal)" stroke-width="1">
      <path d="M 0 30  Q 200 22  400 32  T 800 28  T 1200 34" opacity="0.10" />
      <path d="M 0 60  Q 200 52  400 62  T 800 58  T 1200 64" opacity="0.10" />
      <path d="M 0 90  Q 200 80  400 92  T 800 88  T 1200 94" opacity="0.12" />
      <path d="M 0 130 Q 200 118 400 132 T 800 128 T 1200 134" opacity="0.16" />
      <path d="M 0 170 Q 200 158 400 172 T 800 166 T 1200 174" opacity="0.22" />
      <path d="M 0 210 Q 200 196 400 212 T 800 206 T 1200 214" opacity="0.32" />
    </g>
  </svg>

  {/* Depth labels — real HTML text so they scale with viewport instead
      of stretching with the SVG's preserveAspectRatio="none". Hidden on
      narrow phones where there isn't horizontal room without overlapping
      the footer columns. */}
  <ul
    class="bathy-labels pointer-events-none absolute inset-y-0 left-3 hidden flex-col justify-between py-12 font-mono text-[9px] uppercase tracking-[0.18em] text-teal/55 md:flex"
    aria-hidden="true"
  >
    <li>−5500 m</li>
    <li>−5600 m</li>
    <li>−5700 m</li>
    <li>−5800 m</li>
    <li>−5900 m</li>
    <li>−6000 m</li>
  </ul>

  <div class="relative px-6 py-12 md:pl-24 lg:pl-32 xl:pl-36 lg:pr-16 xl:pr-24 2xl:pr-32">
    <div class="grid gap-8 sm:grid-cols-[2fr_1fr_1fr]">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.20em] text-teal">
          Andrés Pino · andrespino.com
        </p>
        <p class="mt-2 max-w-prose text-sm text-light-slate">
          Senior Electrical &amp; Systems Engineering Leader. Power Electronics
          · Sonar · Undersea Systems &amp; Autonomy · Directed Energy.
        </p>
        <p class="mt-3 font-mono text-[10px] uppercase tracking-widest text-slate">
          San Diego, CA · Active TS Clearance
        </p>
      </div>

      <nav aria-label="Site">
        <p class="font-mono text-[10px] uppercase tracking-[0.20em] text-slate">
          Site
        </p>
        <ul class="mt-2 space-y-1.5 text-sm text-light-slate">
          <li><a href="/#about" class="inline-flex min-h-[44px] items-center hover:text-teal">About</a></li>
          <li><a href="/services/" class="inline-flex min-h-[44px] items-center hover:text-teal">Services</a></li>
          <li><a href="/#experience" class="inline-flex min-h-[44px] items-center hover:text-teal">Experience</a></li>
          <li><a href="/projects/" class="inline-flex min-h-[44px] items-center hover:text-teal">All projects</a></li>
          <li><a href="/#contact" class="inline-flex min-h-[44px] items-center hover:text-teal">Contact</a></li>
          <li><a href="/andres-pino-capability-statement.pdf" class="inline-flex min-h-[44px] items-center hover:text-teal">Capability Statement ↗</a></li>
          <li><a href="/andres-pino-resume.pdf" class="inline-flex min-h-[44px] items-center hover:text-teal">Résumé (PDF) ↗</a></li>
        </ul>
      </nav>

      <nav aria-label="Domain pages">
        <p class="font-mono text-[10px] uppercase tracking-[0.20em] text-slate">
          Domains
        </p>
        <ul class="mt-2 space-y-1.5 text-sm text-light-slate">
          <li><a href="/sonar/" class="inline-flex min-h-[44px] items-center hover:text-teal">Sonar &amp; Acoustics</a></li>
          <li><a href="/auv-uuv/" class="inline-flex min-h-[44px] items-center hover:text-teal">AUV / UUV</a></li>
          <li><a href="/directed-energy/" class="inline-flex min-h-[44px] items-center hover:text-teal">Directed Energy</a></li>
          <li>
            <a
              href="https://www.linkedin.com/in/andresmpino/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] items-center hover:text-teal"
            >
              LinkedIn ↗
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="mt-12 font-mono text-[10px] uppercase tracking-[0.18em] text-slate/85">
      © {year} Andrés Pino · Built with Astro · Hosted on Cloudflare
    </p>
  </div>
</footer>

<style>
  .bathy-footer {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(0 0 0 / 0.30) 60%,
      rgb(0 0 0 / 0.75) 100%
    );
    border-top: 1px solid rgb(56 232 198 / 0.10);
  }
</style>
